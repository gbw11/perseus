[Unit]
Description=Xenova VM agent (MQTT heartbeat)
# instance-id 는 플랫폼 게스트 준비가 기록한다. 없으면 어떤 VM 인지 알 수 없으므로 시작하지 않는다
ConditionPathExists=/etc/xenova/instance-id
After=network-online.target xenova-guest-identity.service
Wants=network-online.target

[Service]
Type=simple
# 선택: XENOVA_AGENT_BROKER_HOST, XENOVA_AGENT_BROKER_USERNAME/PASSWORD, XENOVA_AGENT_HEARTBEAT_INTERVAL, XENOVA_AGENT_LOG_LEVEL
EnvironmentFile=-/etc/xenova/agent.env
# 설치 경로는 플랫폼 템플릿 작업에서 확정한다. perseus_mqtt(mqtt-client)와 xenova_agent 두 패키지가 보여야 한다
Environment=PYTHONPATH=/opt/xenova/mqtt-client:/opt/xenova/agent
ExecStart=/usr/bin/python3 -m xenova_agent
Restart=always
RestartSec=2
KillSignal=SIGTERM
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
