[Unit]
Description=Xenova guest time source on the isolated Xen bridge
BindsTo=xenova-bridge.service
After=xenova-bridge.service

[Service]
ExecStart=@SBINDIR@/xenova-guest-ntp
DynamicUser=yes
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_RAW
RestrictAddressFamilies=AF_INET
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
Restart=on-failure
RestartSec=2s

[Install]
WantedBy=multi-user.target
