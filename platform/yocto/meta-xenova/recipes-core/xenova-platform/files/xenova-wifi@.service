[Unit]
Description=Xenova WPA2 management Wi-Fi on %I
After=sys-subsystem-net-devices-%i.device
BindsTo=sys-subsystem-net-devices-%i.device
ConditionPathExists=/etc/xenova/wifi/%i.conf
JobTimeoutSec=20s

[Service]
Type=simple
ExecStart=/usr/sbin/wpa_supplicant -Dnl80211 -i%i -c/etc/xenova/wifi/%i.conf
Restart=no
TimeoutStopSec=10s
UMask=0077

[Install]
WantedBy=multi-user.target
