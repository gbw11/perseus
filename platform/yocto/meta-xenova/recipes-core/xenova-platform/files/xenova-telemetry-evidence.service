[Unit]
Description=Archive filtered execution evidence from xenconsoled
Requisite=xenova-first-boot.service
RequiresMountsFor=/srv/xenova
After=xenova-first-boot.service xenconsoled.service

[Service]
Type=oneshot
ExecStart=/usr/sbin/xenova-telemetry-support capture-once
TimeoutStartSec=5
UMask=0077
