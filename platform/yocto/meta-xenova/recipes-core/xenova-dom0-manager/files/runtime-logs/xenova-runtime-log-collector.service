[Unit]
Description=Xenova bounded local service log collector
After=systemd-journald.service

[Service]
Type=simple
EnvironmentFile=/etc/xenova/runtime-logs/collector.env
ExecStart=/usr/bin/python3 -m dom0_manager.log_collector --unit xenova-dom0-manager.service --unit xenova-recovery-worker.service --unit xenova-gateway.service --unit mosquitto.service --unit xenova-display-feed.service --unit xenova-display-hdmi.service --unit xenova-display-mobile.service
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
StateDirectory=xenova-runtime-logs
StateDirectoryMode=0700
UMask=0077
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/var/lib/xenova-runtime-logs

[Install]
WantedBy=multi-user.target
