# Inactive template: install an approved copy as root:root 0600 at
# /etc/xenova/gateway.env. Do not enable until Authority/bindings and measured
# vehicle limits are supplied. No initialization or rearm occurs at install.
XENOVA_GATEWAY_PROFILE=warm
XENOVA_GATEWAY_VM_A=
XENOVA_GATEWAY_VM_B=
XENOVA_GATEWAY_BROKER_HOST=
XENOVA_GATEWAY_BROKER_USERNAME=
XENOVA_GATEWAY_BROKER_PASSWORD=
XENOVA_GATEWAY_SINK=serial
XENOVA_GATEWAY_SERIAL_PORT=
XENOVA_GATEWAY_SERIAL_PROFILE=write-only
# feedback-1 requires compatible firmware and an approved positive timeout in ms.
# XENOVA_GATEWAY_FEEDBACK_TIMEOUT_MS is deliberately not supplied here.
XENOVA_GATEWAY_IPC_SOCKET=/run/xenova-gateway/control.sock
XENOVA_GATEWAY_VEHICLE_LIMITS=
XENOVA_GATEWAY_AUTHORITY_DIR=/srv/xenova/drive-control
XENOVA_GATEWAY_BINDING_FILE=/run/xenova/drive-bindings.json
# Optional approved root:root 0600 JSON {retry_ms,retention_ms}; no operating values supplied.
# Selecting history policy requires time-bearing keys for NEW provider requests.
# XENOVA_GATEWAY_HISTORY_POLICY=/etc/xenova/gateway-history.json
