From: Xenova platform
Subject: [PATCH] console: isolate bounded execution-bound evidence I/O
Upstream-Status: Inappropriate [Xenova policy]

--- a/tools/console/daemon/io.c
+++ b/tools/console/daemon/io.c
@@ -88,12 +88,15 @@
 	size_t max_capacity;
 };
 
+#include "xenova_console_evidence_async.h"
+
 struct console {
 	const char *ttyname;
 	int master_fd;
 	int master_pollfd_idx;
 	int slave_fd;
 	int log_fd;
+	struct xdlog evidence;
 	struct buffer buffer;
 	char *xspath;
 	const char *log_suffix;
@@ -342,7 +345,14 @@
 	 * no one is listening on the console pty then it will fill up
 	 * and handle_tty_write will stop being called.
 	 */
-	if (con->log_fd != -1) {
+	if (getenv("XENOVA_CONSOLE_EVIDENCE")) {
+        struct xdlog_enqueue evidence = {
+            .filter = &con->evidence, .domid = dom->domid,
+            .directory = log_dir, .suffix = con->log_suffix
+        };
+        (void)xdlog_feed(&con->evidence, buffer->data + buffer->size - size,
+                         size, xdlog_enqueue, &evidence);
+    } else if (con->log_fd != -1) {
 		int logret;
 		if (log_time_guest) {
 			logret = write_with_timestamp(
@@ -435,6 +445,11 @@
 
 static int create_console_log(struct console *con)
 {
+    /* The optional writer owns all scratch-file I/O; never query Store or
+     * open a file in the PV/PTY event loop for this path. */
+    if (getenv("XENOVA_CONSOLE_EVIDENCE")) {
+        return -1;
+    }
 	char logfile[PATH_MAX];
 	char *namepath, *data, *s;
 	int fd;
@@ -827,6 +842,7 @@
 	con->master_pollfd_idx = -1;
 	con->slave_fd = -1;
 	con->log_fd = -1;
+	memset(&con->evidence, 0, sizeof(con->evidence));
 	con->ring_ref = -1;
 	con->local_port = -1;
 	con->remote_port = -1;
@@ -1325,6 +1341,11 @@
 	int xs_pollfd_idx = -1;
 	xenevtchn_handle *xce_handle = NULL;
 
+    if (getenv("XENOVA_CONSOLE_EVIDENCE") &&
+        xdlog_async_start(xdlog_file_sink)) {
+        dolog(LOG_WARNING, "XENOVA_CONSOLE_EVIDENCE_ASYNC_V1 disabled");
+    }
+
 	if (log_hv) {
 		xce_handle = xenevtchn_open(NULL, 0);
 		if (xce_handle == NULL) {
--- a/tools/console/daemon/Makefile
+++ b/tools/console/daemon/Makefile
@@ -43,3 +43,6 @@
 distclean: clean
 
 -include $(DEPS_INCLUDE)
+
+CFLAGS += -pthread
+LDLIBS += -pthread
