# Raspberry Pi 4 / Xen 이미지 빌드에 적용할 프로젝트 설정 조각.
# platform/scripts/setup-yocto.sh가 새 빌드의 conf/local.conf 관리 블록에 적용한다.

MACHINE = "raspberrypi4-64"
DISTRO = "poky"

INIT_MANAGER = "systemd"
DISTRO_FEATURES:append = " virtualization xen x11 opengl"

PREFERRED_PROVIDER_virtual/kernel = "linux-raspberrypi"

# Xen dom0 메모리 할당.
# 8GiB Raspberry Pi 4 vehicle-display profile: API/MQTT + two Chromium outputs + capture.
# Reassess on smaller boards; this does not alter guest memory reservations.
RPI_DOM0_MEM = "3072M"

# 현재 WSL2 빌드의 임시 자원 제한값이며 호스트에 맞게 조정한다.
BB_NUMBER_THREADS = "4"
PARALLEL_MAKE = "-j 4"

# FFmpeg x11grab/MJPEG is used by the display relay.
LICENSE_FLAGS_ACCEPTED:append = " commercial_ffmpeg"
PACKAGECONFIG:append:pn-ffmpeg = " xcb"
PACKAGECONFIG:pn-chromium-x11 = "use-egl"
