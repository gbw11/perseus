[Unit]
Description=Zenova persistent VM data (verified boot-disk ext4, never formatted here)
Requires=zenova-data-prepare.service
After=zenova-data-prepare.service
JobTimeoutSec=330s

[Mount]
What=/run/zenova/data-device
Where=/srv/zenova
Type=ext4
Options=nodev,nosuid,noexec
TimeoutSec=15s

[Install]
WantedBy=multi-user.target
