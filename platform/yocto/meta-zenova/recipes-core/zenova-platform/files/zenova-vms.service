[Unit]
Description=Start registered Zenova VMs once (OS/app readiness is separate)
Requires=zenova-first-boot.service srv-zenova.mount zenova-xen-ready.service zenova-vm-shutdown.service
After=zenova-first-boot.service srv-zenova.mount zenova-xen-ready.service zenova-vm-shutdown.service
RequiresMountsFor=/srv/zenova

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/zenova-vm autostart
TimeoutStartSec=150s
Restart=no

[Install]
WantedBy=multi-user.target
