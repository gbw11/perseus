[Unit]
Description=Perseus persistent VM data (verified boot-disk ext4, never formatted here)
Requires=perseus-data-prepare.service
After=perseus-data-prepare.service
JobTimeoutSec=330s

[Mount]
What=/run/perseus/data-device
Where=/srv/perseus
Type=ext4
Options=nodev,nosuid,noexec
TimeoutSec=15s

[Install]
WantedBy=multi-user.target
