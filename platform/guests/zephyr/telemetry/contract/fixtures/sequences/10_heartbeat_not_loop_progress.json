{
  "name": "10_heartbeat_not_loop_progress",
  "purpose_ko": "Publisher heartbeat가 계속 와도 실제 loop 완료수는 그대로일 수 있음",
  "test_scope": "reference receiver oracle only; no actual broker or control execution",
  "steps": [
    {
      "op": "bind",
      "vm_id": "11111111-1111-4111-8111-111111111111",
      "boot_id": "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa",
      "publisher_instance_id": "cccccccc-cccc-4ccc-8ccc-cccccccccccc"
    },
    {
      "op": "ingest",
      "file": "fixtures/valid/07_loop_progress.json",
      "received_ms": 0,
      "retained_delivery": false,
      "expected": "CURRENT_OBSERVATION"
    },
    {
      "op": "ingest",
      "file": "fixtures/valid/03_publisher_heartbeat.json",
      "received_ms": 500,
      "retained_delivery": false,
      "expected": "CURRENT_OBSERVATION"
    },
    {
      "op": "ingest",
      "file": "fixtures/valid/08_loop_stalled.json",
      "received_ms": 2000,
      "retained_delivery": false,
      "expected": "CURRENT_OBSERVATION"
    }
  ]
}
