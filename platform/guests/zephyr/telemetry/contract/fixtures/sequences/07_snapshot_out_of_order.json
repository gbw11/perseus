{
  "name": "07_snapshot_out_of_order",
  "purpose_ko": "page 순서는 허용, 전부 수신할 때만 전송완료",
  "test_scope": "reference receiver oracle only; no actual broker or control execution",
  "steps": [
    {
      "op": "bind",
      "vm_id": "11111111-1111-4111-8111-111111111111",
      "boot_id": "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa",
      "publisher_instance_id": "cccccccc-cccc-4ccc-8ccc-cccccccccccc"
    },
    {
      "op": "ingest",
      "file": "fixtures/valid/24_threads_part1.json",
      "received_ms": 0,
      "retained_delivery": false,
      "expected": "SNAPSHOT_PENDING"
    },
    {
      "op": "ingest",
      "file": "fixtures/valid/23_threads_part0.json",
      "received_ms": 100,
      "retained_delivery": false,
      "expected": "SNAPSHOT_COMPLETE"
    }
  ]
}
