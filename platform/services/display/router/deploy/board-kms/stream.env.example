# Copy to a root-owned 0600 file and supply the existing dedicated demo key.
XENOVA_STREAM_TOKEN=
XENOVA_GRAPHICS_ROOT=/opt/xenova-graphics-probe/20261027-1ddf34f25d30/rootfs
XENOVA_STREAM_ENCODER=native_jpeg
XENOVA_NATIVE_JPEG_QUALITY=85
XENOVA_STREAM_FPS=5
# Absolute paths below are inside the graphics root; replace RELEASE explicitly.
XENOVA_STREAM_WORKER_LIB=/opt/xenova-stream/RELEASE/worker-lib
XENOVA_NATIVE_JPEG_LIBRARY=/opt/xenova-stream/RELEASE/native/libturbojpeg.so.0.2.0
