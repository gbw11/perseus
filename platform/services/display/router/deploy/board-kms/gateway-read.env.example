# Driving state is always read from the existing Gateway context (2026-11-06).
# Add only to override the defaults below in the existing private feed environment;
# do not replace its credentials.
XENOVA_DISPLAY_GATEWAY_SOCKET=/run/xenova-gateway/control.sock
XENOVA_DISPLAY_GATEWAY_BUDGET_S=0.5
# XENOVA_DISPLAY_DRIVE_TRANSPORT is retired and ignored (a warning is logged if
# it is not "gateway"). MQTT remains enabled for guest/Agent reports only.
# No broker ACL or Gateway control settings are changed by these options.
