# Opt-in only after the existing Gateway/client and VM pair are verified.
# Add to the existing private feed environment; do not replace its credentials.
XENOVA_DISPLAY_DRIVE_TRANSPORT=gateway
XENOVA_DISPLAY_GATEWAY_SOCKET=/run/xenova-gateway/control.sock
XENOVA_DISPLAY_GATEWAY_BUDGET_S=0.5
# MQTT remains enabled for guest/Agent reports, but not display.drive_state.
# No broker ACL or Gateway control settings are changed by these options.
