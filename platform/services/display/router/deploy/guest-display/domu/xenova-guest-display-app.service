[Unit]
Description=Xenova display domU web UI for dom0's HDMI kiosk (vm-screens files + one read-only data path to dom0)
After=network-online.target
Wants=network-online.target
PartOf=xenova-guest-display.target
ConditionPathExists=/etc/xenova/guest-display-domu.json

[Service]
Type=simple
User=xenova-display
Group=xenova-display
# Python modules installed under /opt/xenova/display-guest (no pip, stdlib only).
Environment=PYTHONPATH=/opt/xenova/display-guest
ExecStart=/usr/bin/python3 -m xenova_display.guest_app --config /etc/xenova/guest-display-domu.json
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
RestrictAddressFamilies=AF_INET AF_UNIX
CapabilityBoundingSet=

[Install]
WantedBy=xenova-guest-display.target
