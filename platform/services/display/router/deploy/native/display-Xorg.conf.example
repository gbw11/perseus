# Verify the actual KMS card before installing as /etc/xenova/display-Xorg.conf.
Section "Device"
    Identifier "XenovaKMS"
    Driver "modesetting"
    Option "kmsdev" "/dev/dri/card0"
    Option "AccelMethod" "none"
EndSection
Section "Screen"
    Identifier "XenovaScreen"
    Device "XenovaKMS"
    DefaultDepth 24
    SubSection "Display"
        Depth 24
        Virtual 3840 2160
    EndSubSection
EndSection
