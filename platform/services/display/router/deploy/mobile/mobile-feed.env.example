# Merge these non-secret settings into the EXISTING /etc/xenova/display.env.
# Do not replace the file or copy placeholder credentials into it.
# The manager must already publish this shared observation file.
XENOVA_OBSERVATIONS_PATH=/run/xenova/vm-observations.json
# Driving state is always read from this Gateway socket (default shown).
XENOVA_DISPLAY_GATEWAY_SOCKET=/run/xenova-gateway/control.sock
# Keep existing token, MQTT observer credentials, VM bindings and network settings.
# USB access + browser session provisioning are issue 349, not this example.
