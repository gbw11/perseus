[Unit]
Description=Xenova dom0 recovery worker (heartbeat watcher, S15P31E110-124)
# 플랫폼 복구 기반 문서의 순서 요구: VM 기동 뒤에 시작하고, 종료 역순에서 host admission barrier 보다 먼저 정리한다.
# PartOf 로 묶지 않는다 (Worker 만 재시작할 때 host 를 quiesce 하지 않는다)
Wants=xenova-recovery-config.service
After=xenova-vms.service mosquitto.service network.target xenova-recovery-config.service
Before=xenova-host-admission.service
# broker 연결 실패는 자체 재접속으로 처리한다. 전역 online 대기로 host admission을 막지 않는다.

[Service]
Type=simple
# XENOVA_DRIVER=platform, XENOVA_PLATFORM_LIB, XENOVA_RECOVERY_* (브로커 계정 포함). dom0-manager 와 같은 파일을 써도 된다
EnvironmentFile=-/etc/xenova/dom0-manager.env
EnvironmentFile=-/run/xenova/recovery-drive.env
EnvironmentFile=-/etc/xenova/recovery-worker.env
Environment=XENOVA_DRIVER=platform
# Yocto가 dom0_manager·xenova_mqtt·Paho를 Python site-packages에 설치한다.
ExecStart=/usr/bin/python3 -m dom0_manager.recovery
Restart=always
RestartSec=5
# 3 = 다른 Worker 가 XENOVA_RECOVERY_STATE_DIR/worker.lock 을 쥐고 있음. 재시작해도 같으므로 멈춘다
RestartPreventExitStatus=3
KillSignal=SIGTERM
TimeoutStopSec=15
UMask=0077
# xl 조회도 libxl의 userdata 잠금을 기록한다. 해당 상태 경로만 쓰기를 허용한다.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/srv/xenova /run/xenova /var/lib/xen
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
LockPersonality=true

[Install]
WantedBy=multi-user.target
