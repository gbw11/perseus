[Unit]
Description=Xenova dom0 recovery worker (heartbeat watcher, S15P31E110-124)
# 플랫폼 복구 기반 문서의 순서 요구: VM 기동 뒤에 시작하고, 종료 역순에서 host admission barrier 보다 먼저 정리한다.
# PartOf 로 묶지 않는다 (Worker 만 재시작할 때 host 를 quiesce 하지 않는다)
After=xenova-vms.service mosquitto.service network-online.target
Before=xenova-host-admission.service
Wants=network-online.target

[Service]
Type=simple
# XENOVA_DRIVER=platform, XENOVA_PLATFORM_LIB, XENOVA_RECOVERY_* (브로커 계정 포함). dom0-manager 와 같은 파일을 써도 된다
EnvironmentFile=-/etc/xenova/dom0-manager.env
EnvironmentFile=-/etc/xenova/recovery-worker.env
Environment=XENOVA_DRIVER=platform
# dom0_manager 와 공용 MQTT 클라이언트(xenova_mqtt) 두 패키지가 보여야 한다. 설치 경로는 플랫폼 패키징에서 확정한다
Environment=PYTHONPATH=/opt/xenova/dom0-manager:/opt/xenova/mqtt-client
ExecStart=/usr/bin/python3 -m dom0_manager.recovery
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=15
# xl·플랫폼 Manager 호출에 root 가 필요하다. 쓰기는 플랫폼 runtime/registry 경로만 허용한다
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/srv/xenova /run/xenova
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
LockPersonality=true

[Install]
WantedBy=multi-user.target
