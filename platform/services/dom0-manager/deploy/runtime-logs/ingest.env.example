PYTHONPATH=/opt/xenova-runtime-logs/lib
XENOVA_RUNTIME_LOG_DB=/var/lib/xenova-runtime-logs/logs.sqlite3
XENOVA_RUNTIME_LOG_INGEST_CONFIG=/etc/xenova/runtime-logs/sources.json
# Bind explicitly to a trusted guest bridge / VPN. Never enable 0.0.0.0 by default.
XENOVA_LOG_INGEST_HOST=127.0.0.1
XENOVA_LOG_INGEST_PORT=8084
