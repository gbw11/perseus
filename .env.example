# 공개 주소와 이미지 태그
PUBLIC_HOST=k15e110.p.ssafy.io
HTTP_PORT=80
IMAGE_TAG=local
TZ=Asia/Seoul

# MySQL: 아래 예시 문자열을 운영용 무작위 비밀번호로 반드시 교체한다.
MYSQL_DATABASE=xenova
MYSQL_USER=xenova
MYSQL_PASSWORD=change-me-mysql-user
MYSQL_ROOT_PASSWORD=change-me-mysql-root

# Redis와 JWT: 서로 다른 무작위 값을 사용한다.
REDIS_PASSWORD=change-me-redis
JWT_SECRET=change-me-to-at-least-32-random-bytes

# HTTPS 적용 전에는 false, 인증서와 443 프록시 적용 후에는 true로 바꾼다.
AUTH_COOKIE_SECURE=false

# dom0-manager/MQTT가 EC2 외부에 있으면 실제 내부 주소로 바꾼다.
DOM0_MANAGER_BASE_URL=http://host.docker.internal:8081
DOM0_MANAGER_SERVICE_TOKEN=
MQTT_ENABLED=false
MQTT_BROKER_URL=tcp://host.docker.internal:1883
XENOVA_DISPLAY_SERVICE_TOKEN=

# Frontend는 같은 Nginx origin의 /api와 /ws를 사용한다.
VITE_API_BASE_URL=
VITE_SCREENS_ORIGIN=/screens
VITE_TELEMETRY=live
