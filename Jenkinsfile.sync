// GitLab의 accepted MR webhook에서 source/target 브랜치를 읽어,
// develop에 병합된 파트 브랜치만 최신 develop 커밋으로 fast-forward한다.
pipeline {
    agent any

    options {
        gitLabConnection('gitlab')
        timeout(time: 10, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '30'))
        disableConcurrentBuilds()
    }

    triggers {
        gitlab(
            triggerOnPush: false,
            triggerOnMergeRequest: false,
            triggerOnAcceptedMergeRequest: true,
            branchFilterType: 'NameBasedFilter',
            includeBranchesSpec: 'develop',
            excludeBranchesSpec: ''
        )
    }

    environment {
        GITLAB_PUSH_CREDENTIALS_ID = 'xenova-gitlab-write-token'
    }

    stages {
        stage('Sync merged part branch') {
            when {
                expression {
                    env.gitlabTargetBranch == 'develop' &&
                        ['platform', 'frontend', 'backend', 'vehicle'].contains(env.gitlabSourceBranch)
                }
            }
            steps {
                withCredentials([usernamePassword(
                    credentialsId: env.GITLAB_PUSH_CREDENTIALS_ID,
                    usernameVariable: 'GITLAB_HTTP_USER',
                    passwordVariable: 'GITLAB_HTTP_TOKEN'
                )]) {
                    sh '''
                        set -eu

                        source_branch="$gitlabSourceBranch"
                        target_branch="$gitlabTargetBranch"

                        case "$source_branch" in
                            platform|frontend|backend|vehicle) ;;
                            *)
                                echo "Unsupported source branch: $source_branch" >&2
                                exit 1
                                ;;
                        esac

                        if [ "$target_branch" != 'develop' ]; then
                            echo "Expected target branch develop, got $target_branch" >&2
                            exit 1
                        fi

                        askpass="$(mktemp)"
                        trap 'rm -f "$askpass"' EXIT
                        printf '%s\n' \
                          '#!/bin/sh' \
                          'case "$1" in' \
                          '  *Username*) printf "%s\\n" "$GITLAB_HTTP_USER" ;;' \
                          '  *Password*) printf "%s\\n" "$GITLAB_HTTP_TOKEN" ;;' \
                          'esac' > "$askpass"
                        chmod 700 "$askpass"
                        export GIT_ASKPASS="$askpass"
                        export GIT_TERMINAL_PROMPT=0

                        repository_url='https://lab.ssafy.com/s15-final/S15P31E110.git'
                        git fetch --no-tags "$repository_url" \
                          "+refs/heads/${target_branch}:refs/remotes/origin/${target_branch}" \
                          "+refs/heads/${source_branch}:refs/remotes/origin/${source_branch}"

                        target_tip="$(git rev-parse "origin/$target_branch")"
                        source_tip="$(git rev-parse "origin/$source_branch")"

                        if ! git merge-base --is-ancestor "$source_tip" "$target_tip"; then
                            echo "origin/$source_branch is not contained in origin/$target_branch; refusing automatic sync." >&2
                            exit 1
                        fi

                        git push -o ci.skip "$repository_url" \
                          "${target_tip}:refs/heads/${source_branch}"
                    '''
                }
            }
        }
    }

    post {
        notBuilt {
            echo "Skipping sync: source=${env.gitlabSourceBranch}, target=${env.gitlabTargetBranch}"
        }
    }
}
