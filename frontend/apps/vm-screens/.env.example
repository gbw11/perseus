# 이 파일을 .env.local 로 복사해 바꾼다 (.env.local 은 Git 에 올라가지 않는다)
# (비움) = 관리 콘솔 mock 시나리오를 따라감 (콘솔 개발 서버의 /monitor/ 로 열 때)
# live = 백엔드 /ws/v1/drive/state·/ws/v1/events 에 붙는다
# scenario = 이 앱 혼자 도는 가짜 시나리오 (조작 없음, 시험·디자인용)
VITE_TELEMETRY=
# 관리 콘솔 개발 서버가 넘겨 줄 경로. 콘솔과 같이 볼 때 /monitor/
VITE_BASE=/
# 개발 서버가 /api·/ws 를 넘길 백엔드 주소
VITE_BACKEND_ORIGIN=http://localhost:8080
# API 기본 경로. 개발 서버 프록시를 쓰면 비워 둔다 (같은 origin)
VITE_API_BASE_URL=
# live 에서 refresh 쿠키가 없을 때 쓸 개발용 계정 (실제 비밀번호를 적지 않는다)
VITE_SCREEN_USERNAME=
VITE_SCREEN_PASSWORD=
