# 이 파일을 .env.local 로 복사해 바꾼다 (.env.local 은 Git 에 올라가지 않는다)
# 개발 서버가 /api·/ws 를 넘길 백엔드 주소
VITE_BACKEND_ORIGIN=http://localhost:8080
# API 기본 경로. 개발 서버 프록시를 쓰면 비워 둔다 (같은 origin)
VITE_API_BASE_URL=
# true 면 MSW mock 으로 동작 (S15P31E110-52)
VITE_MOCK=false
# 실제 배포에서 합의된 UUID 세 개를 JSON으로 지정. 비우면 VM 이름 그대로 표시하고 역할 추정 금지.
# 예: {"primary_drive":"<VM1 UUID>","backup_drive":"<VM2 UUID>","interaction":"<VM3 UUID>"}
VITE_VM_ROLE_BINDINGS=
# 세 번째 VM AI 감지 영상 MJPEG 주소 (카메라 계약 camera-stream-v1). 비우면 /camera/stream.mjpg (dom0 웹 프록시), mock 은 시험 영상
VITE_CAMERA_URL=
