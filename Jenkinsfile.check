// Xenova integration check
// xenova-develop-check과 xenova-master-check Job이 공통으로 사용한다.
// MR merge 결과에서 Backend·Frontend·Platform·Docker 구성을 모두 검사하며 배포는 하지 않는다.

pipeline {
    agent any

    options {
        gitLabConnection('gitlab')
        timeout(time: 30, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '30'))
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
    }

    stages {
        stage('Checkout Merge Request') {
            steps {
                script {
                    if (!env.gitlabSourceBranch || !env.gitlabTargetBranch) {
                        error('This job must be started by a GitLab Merge Request webhook.')
                    }

                    checkout([
                        $class: 'GitSCM',
                        branches: [[name: "origin/${env.gitlabTargetBranch}"]],
                        userRemoteConfigs: [[
                            credentialsId: 'xenova-gitlab-checkout',
                            name: 'origin',
                            refspec: '+refs/heads/*:refs/remotes/origin/*',
                            url: 'https://lab.ssafy.com/s15-final/S15P31E110.git'
                        ]]
                    ])
                    withEnv(["MR_SOURCE_REF=origin/${env.gitlabSourceBranch}"]) {
                        sh '''git -c user.name='Xenova Jenkins' -c user.email='jenkins@k15e110.p.ssafy.io' merge --no-edit "$MR_SOURCE_REF"'''
                    }
                }
            }
        }

        stage('Backend Test') {
            steps {
                updateGitlabCommitStatus name: integrationStatusName(), state: 'running'
                dir('backend') {
                    sh './mvnw -B -ntp test'
                }
            }
        }

        stage('Frontend Quality') {
            steps {
                dir('frontend') {
                    sh 'npm ci'
                    sh 'npm run lint'
                    sh 'npm run typecheck'
                    sh 'mkdir -p target && npm test -- --reporter=junit --outputFile=target/vitest.xml'
                    withEnv([
                        'VITE_BASE_PATH=/screens/',
                        'VITE_SCREENS_ORIGIN=/screens',
                        'VITE_TELEMETRY=live'
                    ]) {
                        sh 'npm run build'
                    }
                }
            }
        }

        stage('Compose Validate') {
            environment {
                MYSQL_PASSWORD = 'ci-compose-validation-only'
                MYSQL_ROOT_PASSWORD = 'ci-compose-validation-root-only'
                REDIS_PASSWORD = 'ci-compose-validation-only'
                JWT_SECRET = 'ci-compose-validation-secret-at-least-32-bytes'
            }
            steps {
                sh 'docker compose -f compose.yaml config --quiet'
            }
        }

        stage('Docker Image Build') {
            steps {
                sh 'docker build --target runtime -t xenova-backend:check-${BUILD_NUMBER} backend'
                sh 'docker build --target admin-console -t xenova-admin-console:check-${BUILD_NUMBER} frontend'
                sh 'docker build --target vm-screens -t xenova-vm-screens:check-${BUILD_NUMBER} frontend'
            }
        }

        stage('dom0-manager Test') {
            steps {
                dir('platform/services/dom0-manager') {
                    catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                        sh 'mkdir -p target'
                        sh 'python3 -m pip install -q --user -e .[test] && python3 -m pytest -q --junitxml=target/pytest.xml'
                    }
                }
            }
        }

        stage('vm-agent Test') {
            steps {
                catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                    dir('platform/services/vm-agent/mqtt-client') {
                        sh 'mkdir -p target'
                        sh 'python3 -m pip install -q --user "paho-mqtt>=1.6,<3" "pytest>=7" && python3 -m pytest -q --junitxml=target/pytest.xml'
                    }
                    dir('platform/services/vm-agent/agent') {
                        sh 'mkdir -p target'
                        sh 'python3 -m pytest -q --junitxml=target/pytest.xml'
                    }
                }
            }
        }

        stage('Vehicle Python Test') {
            // Jenkinsfile.vehicle 과 같은 시험. 시뮬레이터·인지·수동 앱 (OpenCV 불필요, 브로커 시험은 건너뜀)
            steps {
                catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                    script {
                        for (app in ['simulator', 'perception', 'manual']) {
                            dir("platform/apps/${app}") {
                                sh 'mkdir -p target'
                                sh 'python3 -m pip install -q --user -e .[test] && python3 -m pytest -q --junitxml=target/pytest.xml'
                            }
                        }
                    }
                }
            }
        }

        stage('Vehicle C Host Test') {
            // Jenkinsfile.vehicle 과 같은 시험. 공통 MQTT C 라이브러리와 Zephyr 앱 로직 (cmake·ctest, ASan·UBSan)
            steps {
                catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                    script {
                        def suites = [
                            'mqtt-c'    : 'platform/apps/common/xenova-mqtt-c',
                            'manual'    : 'platform/apps/manual/zephyr/tests',
                            'autonomous': 'platform/apps/autonomous/zephyr/tests',
                        ]
                        suites.each { name, source ->
                            sh """
                                cmake -S ${source} -B target/c-host/${name} -DCMAKE_EXE_LINKER_FLAGS=-no-pie
                                cmake --build target/c-host/${name} -j 2
                                ctest --test-dir target/c-host/${name} --output-on-failure --output-junit ctest.xml
                            """
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            junit testResults: 'backend/target/surefire-reports/*.xml,frontend/target/vitest.xml,platform/services/dom0-manager/target/pytest.xml,platform/services/vm-agent/mqtt-client/target/pytest.xml,platform/services/vm-agent/agent/target/pytest.xml,platform/apps/simulator/target/pytest.xml,platform/apps/perception/target/pytest.xml,platform/apps/manual/target/pytest.xml,target/c-host/*/ctest.xml', allowEmptyResults: true
            sh '''
                if command -v docker >/dev/null 2>&1; then
                    docker image rm \
                      xenova-backend:check-${BUILD_NUMBER} \
                      xenova-admin-console:check-${BUILD_NUMBER} \
                      xenova-vm-screens:check-${BUILD_NUMBER} >/dev/null 2>&1 || true
                fi
            '''
        }
        success {
            updateGitlabCommitStatus name: integrationStatusName(), state: 'success'
            notifyMattermost('good', '✅ CI 성공')
        }
        unstable {
            updateGitlabCommitStatus name: integrationStatusName(), state: 'failed'
            notifyMattermost('warning', '⚠️ CI 불안정')
        }
        failure {
            updateGitlabCommitStatus name: integrationStatusName(), state: 'failed'
            notifyMattermost('danger', '❌ CI 실패')
        }
        aborted {
            updateGitlabCommitStatus name: integrationStatusName(), state: 'canceled'
            notifyMattermost('warning', '⚠️ CI 중단')
        }
    }
}

def integrationStatusName() {
    return env.gitlabTargetBranch == 'master' ? 'jenkins-master-check' : 'jenkins-develop-check'
}

// Mattermost 웹훅 URL과 채널은 Jenkins 시스템 설정(Global Mattermost Notifier Settings)에 둔다.
def notifyMattermost(String color, String title) {
    def sourceBranch = env.gitlabSourceBranch ?: '-'
    def targetBranch = env.gitlabTargetBranch ?: '-'
    def author = env.gitlabUserName ?: '-'
    def duration = currentBuild.durationString.replace(' and counting', '')

    mattermostSend color: color, message: """#### ${title}
- Source: `${sourceBranch}`
- Target: `${targetBranch}`
- Author: ${author}
- Duration: ${duration}
- Build: [${env.JOB_NAME} #${env.BUILD_NUMBER}](${env.BUILD_URL})"""
}
